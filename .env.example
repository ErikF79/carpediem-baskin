# Copia questo file in ".env" e compila i valori.
# In locale puoi lasciare DATABASE_URL vuoto: verra usato SQLite.
DATABASE_URL=

# Password condivisa per l'area staff
STAFF_PASSWORD=cambiami

# Chiave segreta per firmare i cookie di sessione (genera una stringa lunga e casuale)
SECRET_KEY=super-secret-change-me

# Nome mostrato nell'interfaccia
APP_NAME=CarpeDiem Baskin
